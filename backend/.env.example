# Django Configuration
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=*

# Database (leave blank for local SQLite; Railway supplies DATABASE_URL)
DATABASE_URL=
DATABASE_CONN_MAX_AGE=60

# Dhan API Credentials (demo mode is enabled by default)
DHAN_DEMO_MODE=true
DEMO_MODE=true
DHAN_CLIENT_ID=
DHAN_PIN=
DHAN_TOTP_SECRET=
# Optional manual 24-hour token fallback
DHAN_ACCESS_TOKEN=
DHAN_TOKEN_REFRESH_BUFFER_MINUTES=30

# Celery & Redis (Railway web, worker, and beat use the same Redis URL)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=True

# Production browser/security settings
# ALLOWED_HOSTS=capitalpilot-production.up.railway.app,healthcheck.railway.app
# CORS_ALLOWED_ORIGINS=https://capitalpilot-production.up.railway.app
# CSRF_TRUSTED_ORIGINS=https://capitalpilot-production.up.railway.app
# SECURE_SSL_REDIRECT=true
